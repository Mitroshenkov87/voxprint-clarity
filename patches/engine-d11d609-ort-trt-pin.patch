 import importlib.util as util
 import sys
 missing = [name for name in ("torch", "onnxruntime") if util.find_spec(name) is None]
+names = {dist.metadata["Name"].lower() for dist in meta.distributions() if dist.metadata and dist.metadata.get("Name")}
+if "onnxruntime" in names:
+    missing.append("cpu-onnxruntime")
 try:
