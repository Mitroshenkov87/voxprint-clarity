@@ -260,17 +266,37 @@
 
 
 def install_gpu_wheels(python: str, progress: Progress | None = None) -> None:
-    """Install torch for CUDA 13, then the ONNX Runtime GPU and TensorRT wheels."""
+    """Install torch for CUDA 13, then ONNX Runtime GPU 1.31 and TensorRT 10.14.
+
+    The CPU ``onnxruntime`` wheel shadows ``onnxruntime-gpu``. Unpinned
+    ``tensorrt-cu13`` is TensorRT 11 (``nvinfer_11``). ONNX Runtime 1.31 loads
+    ``nvinfer_10`` from ``tensorrt-cu13-libs`` 10.14.1.48. Bindings for that
+    TensorRT have no cp314 wheel, so the meta package is recorded with
+    ``--no-deps`` and the DLLs come from the libs wheel.
+    """
     if getattr(sys, "frozen", False):
         raise SuiteInstallError("install the app directory, then run voxprint-enlarge --install-gpu")
     if not python:
         raise SuiteInstallError("a Python executable is required")
     _pip(python, ["install", "torch", "--index-url", TORCH_INDEX], "Installing torch for CUDA 13", progress, required=True)
-    _pip(python, ["uninstall", "-y", "onnxruntime"], "Removing the CPU ONNX Runtime wheel", progress, required=False)
     _pip(
         python,
-        ["install", "onnxruntime-gpu>=1.20,<2", "tensorrt-cu13"],
-        "Installing ONNX Runtime GPU and TensorRT",
+        ["uninstall", "-y", "onnxruntime", "onnxruntime-gpu", "tensorrt", "tensorrt-cu13", "tensorrt-cu13-bindings", "tensorrt-cu13-libs"],
+        "Removing the CPU ONNX Runtime wheel and TensorRT 11",
+        progress,
+        required=False,
+    )
+    _pip(
+        python,
+        ["install", "--extra-index-url", "https://pypi.nvidia.com", "onnxruntime-gpu==1.31.0", "tensorrt-cu13-libs==10.14.1.48"],
+        "Installing ONNX Runtime GPU 1.31 and TensorRT 10.14",
+        progress,
+        required=True,
+    )
+    _pip(
+        python,
+        ["install", "--no-deps", "tensorrt-cu13==10.14.1.48"],
+        "Recording the TensorRT 10.14 package without its bindings",
         progress,
         required=True,
     )
